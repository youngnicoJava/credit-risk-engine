{
  "dependencies": {
    "prettier": "^3.9.9"
  },
  "scripts": {
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{json,html,ts}\" \"docs/**/*.md\" README.md",
    "format:check": "prettier --check \"frontend/src/**/*.{ts,tsx,css}\" \"frontend/*.{json,html,ts}\" \"docs/**/*.md\" README.md"
  }
}
